rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // 1. Waitlist Leads Collection (Real-time live counter & reservation sync)
    match /waitlist/{leadId} {
      allow read, write: if isValidId(leadId);
    }

    // 2. Customers / Subscribers Collection (Cross-browser admin management & auth synchronization)
    match /customers/{customerId} {
      allow read, write: if isValidId(customerId);
    }

    // 3. Orders Collection (Real-time order submission & payment verification)
    match /orders/{orderId} {
      allow read, write: if isValidId(orderId);
    }

    // 4. Testimonials (Public Read, Admin Write)
    match /testimonials/{testimonialId} {
      allow read, write: if isValidId(testimonialId);
    }

    // 5. Announcements
    match /announcements/{announcementId} {
      allow read, write: if isValidId(announcementId);
    }
  }
}


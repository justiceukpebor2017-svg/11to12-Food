rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Waitlist Leads Collection (Real-time live counter & waitlist registration)
    match /waitlist/{leadId} {
      allow read, write: if true;
    }

    // 2. Customers / Subscribers Collection (Cross-device account management & profile sync)
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // 3. Orders Collection (Real-time order submission & payment verification)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 4. Testimonials (Public testimonials)
    match /testimonials/{testimonialId} {
      allow read, write: if true;
    }

    // 5. Announcements
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // 6. System health ping
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}

